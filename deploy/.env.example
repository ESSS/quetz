# Copy to deploy/.env (gitignored), chmod 600, owned by root. Values below are quetz02's.

# The postgres user's password, hex only (it goes into the DB URL unescaped). On an existing
# data dir initdb doesn't run, so this must match the cluster's password.
POSTGRES_PASSWORD=CHANGE_ME
PG_DATA_DIR=/home/users/fred/postgres/data/postgres

# The deployment dir, with its own config.toml (GitHub, session and [users] settings).
QUETZ_DEPLOYMENT_DIR=/home/users/fred/quetz_server
# Owner of the package store (fred : domain users).
QUETZ_UID=1776201211
QUETZ_GID=1776200513

# Clients whose X-Forwarded-* headers uvicorn trusts. '*' as under systemd: the proxy in front of
# packages.esss.com connects from several addresses (10.0.1.251, .253, ...), and an untrusted proxy
# makes every request look like http, which redirect_http_to_https turns into a redirect loop.
# uvicorn 0.29 takes exact IPs only, no CIDR.
FORWARDED_ALLOW_IPS=*

# Optional: QUETZ_SRC (default: this checkout), QUETZ_PORT (default: 8000).
